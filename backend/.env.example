# Application
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=qstack_user
DATABASE_PASSWORD=qstack_secret_password
DATABASE_NAME=qstack_db
DATABASE_SSL=false

# Redis & Event Bus
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET=your-super-secret-access-token-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Super Admin Seed
SUPER_ADMIN_EMAIL=superadmin@qstack.dev
SUPER_ADMIN_PASSWORD=SuperAdmin@QStack2026!
SUPER_ADMIN_NAME=Super Admin

# External AI Services (Required for Phase 4)
GEMINI_API_KEY=
PINECONE_API_KEY=
PINECONE_INDEX=qstack-qa-index
PINECONE_ENVIRONMENT=

# OAuth (Phase 1)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/api/v1/auth/github/callback
